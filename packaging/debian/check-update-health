#!/usr/bin/env python3
"""Confirm that the installed release has a stable, responsive application."""

import argparse
import json
import subprocess
import sys
import time
import urllib.request


def service_pid(timeout):
    result = subprocess.run(
        ["systemctl", "show", "teletool.service", "--property=ActiveState", "--property=MainPID"],
        capture_output=True, text=True, timeout=timeout, check=True,
    )
    fields = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
    pid = int(fields.get("MainPID") or "0")
    if fields.get("ActiveState") != "active" or pid <= 0:
        raise RuntimeError("TeleTool service is not active")
    return pid


def get_json(path, timeout):
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open("http://127.0.0.1:8000" + path, timeout=timeout) as response:
        return json.load(response)


def wait_for_health(version, branch, timeout_s=60.0):
    deadline = time.monotonic() + timeout_s
    healthy_pid = None
    error = "TeleTool did not become ready"

    def remaining():
        left = deadline - time.monotonic()
        if left <= 0:
            raise TimeoutError("Health check deadline reached")
        return min(2.0, left)

    while time.monotonic() < deadline:
        try:
            pid = service_pid(remaining())
            release = get_json("/api/release", remaining())
            if str(release.get("version", "")).lstrip("Vv") != version.lstrip("Vv") or release.get("branch") != branch:
                raise RuntimeError("TeleTool is not serving the requested release")
            status = get_json("/api/status?lite=1&logs=0&stats=0&rf=0", remaining())
            if not isinstance(status.get("running"), bool) or "pipeline_state" not in status:
                raise RuntimeError("TeleTool status API is not ready")
            # Two checks on the same process catch immediate startup crash loops.
            if healthy_pid == pid:
                return
            healthy_pid = pid
        except Exception as exc:
            healthy_pid = None
            error = str(exc)
        time.sleep(min(2.0, max(0.0, deadline - time.monotonic())))
    raise RuntimeError("TeleTool did not recover after the update: " + error)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version")
    parser.add_argument("branch", choices=("main", "dev"))
    args = parser.parse_args()
    try:
        wait_for_health(args.version, args.branch)
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print("TeleTool service and release API are healthy.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
